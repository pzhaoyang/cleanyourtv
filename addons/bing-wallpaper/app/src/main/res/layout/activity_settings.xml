<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="72dp"
    android:paddingEnd="72dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp"
    android:background="#FF0B1220">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:id="@+id/count"
        android:textColor="#FF9FB4C7"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/option_seconds"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/sec15" style="@style/Choice" android:text="15" />
        <TextView android:id="@+id/sec30" style="@style/Choice" android:text="30" />
        <TextView android:id="@+id/sec60" style="@style/Choice" android:text="60" />
        <TextView android:id="@+id/sec120" style="@style/Choice" android:text="120" />
        <TextView android:id="@+id/sec300" style="@style/Choice" android:text="300" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/option_seconds_hint"
        android:textColor="#FF7D94A8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/captionChoice"
        style="@style/Choice"
        android:layout_width="match_parent"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/refreshChoice"
        style="@style/Choice"
        android:layout_width="match_parent"
        android:layout_marginTop="14dp"
        android:text="@string/option_refresh" />
</LinearLayout>
