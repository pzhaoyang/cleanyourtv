<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A pill of numbers, and a full-width row for a switch. Focus is what a remote shows. -->
    <style name="Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@drawable/choice_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/choice_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
